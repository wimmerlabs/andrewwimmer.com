{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Must match the Worker name in the Cloudflare dashboard (Workers Builds).
  "name": "andrewwimmer-com",
  "compatibility_date": "2026-10-24",
  // The site lives at andrewwimmer.com (custom domain, attached in the dashboard;
  // www redirects there via a Redirect Rule). The temporary workers.dev address is off.
  "workers_dev": false,
  // Per-version preview links (Cloudflare marks them noindex automatically).
  "preview_urls": true,
  // Don't send Wrangler usage telemetry from builds.
  "send_metrics": false,

  // The small server for the Connect flow. It only runs for the paths in
  // run_worker_first below; every other path is served straight from ./dist.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/connect/status/*"]
  },

  // Contact requests. Schema in migrations/.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "andrewwimmer-connect",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  // Hourly: delete requests older than 90 days, retry failed Grok Bot pings.
  "triggers": { "crons": ["17 * * * *"] },

  // Secrets (set in the dashboard, never here): GROK_WEBHOOK_URL,
  // GROK_WEBHOOK_SECRET, IP_SALT. For local testing, put them in .dev.vars.
  "observability": { "enabled": true }
}
