{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Must match the Worker name in the Cloudflare dashboard (Workers Builds).
  "name": "andrewwimmer-com",
  "compatibility_date": "2026-10-24",
  // The site lives at andrewwimmer.com (custom domain, attached in the dashboard;
  // www redirects there via a Redirect Rule). The temporary workers.dev address is off.
  "workers_dev": false,
  // Per-version preview links (Cloudflare marks them noindex automatically).
  "preview_urls": true,
  // Don't send Wrangler usage telemetry from builds.
  "send_metrics": false,

  // The small server for the Connect flow. It only runs for the paths in
  // run_worker_first below; every other path is served straight from ./dist.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/connect/status/*"]
  },

  // Contact requests. Schema in migrations/.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "andrewwimmer-connect",
      "database_id": "89c9f782-3123-4a2b-9426-ce0a15f3f2d1",
      "migrations_dir": "migrations"
    }
  ],

  // Private storage for the resume PDF. Never public: the Worker serves it only to
  // approved requesters. Upload a new PDF in the dashboard; the newest one is used.
  "r2_buckets": [{ "binding": "RESUME", "bucket_name": "andrewwimmer-private" }],

  // Hourly: delete requests older than 90 days, retry failed Grok Bot pings.
  "triggers": { "crons": ["17 * * * *"] },

  // Secrets (set in the dashboard, never here): GROK_WEBHOOK_URL, GROK_WEBHOOK_SECRET,
  // IP_SALT, BOT_TOKEN, and CONTACT_EMAIL / _PHONE / _SIGNAL / _TELEGRAM / _NOSTR.
  // For local testing, put fake values in .dev.vars (git-ignored).
  "observability": { "enabled": true }
}
