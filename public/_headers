/*
  Content-Security-Policy: default-src 'self'; img-src 'self'; style-src 'self'; font-src 'self'; script-src 'none'; connect-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# Text files for people and AI agents: declare UTF-8 so characters like · and – survive.
/llms.txt
  Content-Type: text/plain; charset=utf-8
/*.json
  Content-Type: application/json; charset=utf-8

# Fingerprinted build files never change: cache for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Images rarely change: cache for a day.
/images/*
  Cache-Control: public, max-age=86400

# Keep the temporary review address out of search results.
https://andrewwimmer-com.:subdomain.workers.dev/*
  X-Robots-Tag: noindex
