---
// Real covers come from Open Library (downloaded once by scripts/fetch-covers.mjs
// and served from this site). Books without one get a cover drawn from the
// title and author.
interface Props {
  title: string;
  author: string;
  src?: string;
  index?: number;
  unread?: boolean;
}
const { title, author, src, index = 0, unread = false } = Astro.props;
---

{
  src ? (
    <div class:list={['cover-frame', { 'cover-frame--unread': unread }]}>
      <img src={src} alt="" loading="lazy" decoding="async" />
    </div>
  ) : (
    <div class:list={['cover', unread ? 'cover--unread' : `cover--${index % 6}`]} aria-hidden="true">
      <p class="cover__title">{title}</p>
      <p class="cover__author">{author}</p>
    </div>
  )
}
