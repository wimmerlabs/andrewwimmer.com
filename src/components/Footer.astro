    <div class="site-footer__about">
      <p><strong>A Wimmer Labs build.</strong></p>
      <p>Astro 7 on Cloudflare Workers, written alongside Claude Code.</p>
      <p>No trackers, no cookies, no affiliates, no monetization.</p>
      <p class="mono">Updated {site.updated}</p>
    </div>
    <nav class="footer-nav" aria-label="Footer">
      <a href="/colophon/">Colophon</a>
      <a href={site.links.repo} rel="noopener">Source on GitHub</a>
      <a href="/llms.txt">llms.txt</a>
      <a href={site.links.linkedin} rel="me noopener">LinkedIn</a>
    </nav>
  </div>
</footer>
