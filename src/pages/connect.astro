---
import Base from '../layouts/Base.astro';
import { contactItems, connect } from '../data/connect';
---

<Base
  title="Connect"
  current="connect"
  description="Request Andrew Wimmer's contact details or resume. Requests go to his AI agent and he approves each one."
>
  <div class="container page">
    <header class="page-head">
      <div class="page-head__text">
        <p class="eyebrow">Connect</p>
        <h1 class="page-title">Looking to connect?</h1>
        <p class="page-intro">
          Tell me who you are and what you're after. My AI agent checks who's asking, I approve, and you get a private link.
        </p>
      </div>
    </header>

    <div class="connect-layout">
      <form class="card form" id="form" method="post" action="/api/connect">
        <div class="form__row">
          <div class="field">
            <label for="name">Your name</label>
            <input id="name" name="name" type="text" required maxlength={connect.max.name} autocomplete="name" />
          </div>
          <div class="field">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" required maxlength={connect.max.email} autocomplete="email" />
          </div>
        </div>

        <div class="form__row">
          <div class="field">
            <label for="company">Company <span class="field__optional">optional</span></label>
            <input id="company" name="company" type="text" maxlength={connect.max.company} autocomplete="organization" />
          </div>
          <div class="field">
            <label for="link">LinkedIn or website <span class="field__optional">optional</span></label>
            <input id="link" name="link" type="text" inputmode="url" maxlength={connect.max.link} autocomplete="url" />
          </div>
        </div>

        <fieldset class="field">
          <legend>What would you like?</legend>
          <ul class="checks">
            {
              contactItems.map((item) => (
                <li>
                  <label class="check">
                    <input type="checkbox" name="wants" value={item.key} />
                    {item.label}
                  </label>
                </li>
              ))
            }
          </ul>
        </fieldset>

        <div class="field">
          <label for="note">A note for me</label>
          <p class="field__hint" id="note-hint">What's this about? A sentence or two is plenty.</p>
          <textarea id="note" name="note" rows="5" required maxlength={connect.max.note} aria-describedby="note-hint"></textarea>
        </div>

        <div class="hp" aria-hidden="true">
          <label for="website">Leave this empty</label>
          <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="form__foot">
          <button class="btn btn--accent" type="submit">Send request</button>
          <p class="fineprint">You'll get your private link right away. Save it.</p>
        </div>
      </form>

      <aside class="prose connect-aside">
        <h2>How it works</h2>
        <ol>
          <li>You send a request and get a private link right away. Save it.</li>
          <li>My AI agent looks it over and sends me a summary.</li>
          <li>I decide myself. My agent emails you when I do, and your link shows whatever I approve, for {connect.linkDays} days.</li>
        </ol>

        <h2>Your privacy</h2>
        <ul>
          <li>Your request is shared with my AI agent (Grok, by xAI) so it can check who's asking.</li>
          <li>Requests are deleted after {connect.keepDays} days. No mailing lists, no tracking.</li>
        </ul>

        <h2>Sending from an AI agent?</h2>
        <p>POST JSON to <code>/api/connect</code>. The format is at <a href="/api/connect">/api/connect</a> and in <a href="/llms.txt">llms.txt</a>.</p>
      </aside>
    </div>
  </div>
</Base>
